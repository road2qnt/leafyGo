DATABASE_URL=postgres://postgres:postgres@localhost:5432/leafygo?sslmode=disable
# 32 bytes, base64 atau hex. Generate: openssl rand -base64 32
ENCRYPTION_KEY=
ADDR=:8080
APP_ENV=development
# Default true bila APP_ENV=production. Set false bila production diakses lewat HTTP biasa.
COOKIE_SECURE=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/leafygo_test?sslmode=disable
UI_PREVIEW=false
TEST_TARGET_DATABASE_URL=postgres://postgres:postgres@localhost:5432/leafygo_target_test?sslmode=disable
TARGET_CONNECT_TIMEOUT=5s
VIEWER_STATEMENT_TIMEOUT=5s
MIGRATION_ADVISORY_LOCK_TIMEOUT=10s
# Batas total eksekusi migration, termasuk waktu koneksi.
MIGRATION_TIMEOUT=30s
MAX_MIGRATION_BYTES=1048576
VIEWER_PAGE_SIZE=50
VIEWER_MAX_PAGE_SIZE=100
# Durasi sesi: idle, batas mutlak, interval rotasi ID, dan masa berlaku ID lama setelah rotasi.
SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=8h
SESSION_ROTATE_INTERVAL=15m
SESSION_GRACE_PERIOD=10s
# Seeder (cmd/seed). Host dan port juga dipakai sebagai alamat koneksi di app.
SEED_USER_PASSWORD=password123
SEED_TARGETS_HOST=localhost
SEED_TARGETS_PORT=5434
SEED_ANALYTICS_HOST=localhost
SEED_ANALYTICS_PORT=5436
SEED_SUPERUSER=postgres
SEED_SUPERUSER_PASSWORD=postgres
SEED_APP_DB_USER=leafygo_app
SEED_APP_DB_PASSWORD=leafygo_app
