DATABASE_URL=postgres://postgres:postgres@localhost:5432/leafygo?sslmode=disable
# 32 bytes, base64 atau hex. Generate: openssl rand -base64 32
ENCRYPTION_KEY=
ADDR=:8080
APP_ENV=development
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/leafygo_test?sslmode=disable
TEST_TARGET_DATABASE_URL=postgres://postgres:postgres@localhost:5432/leafygo_target_test?sslmode=disable
TARGET_CONNECT_TIMEOUT=5s
VIEWER_STATEMENT_TIMEOUT=5s
MIGRATION_ADVISORY_LOCK_TIMEOUT=10s
# Batas total eksekusi migration, termasuk waktu koneksi.
MIGRATION_TIMEOUT=30s
MAX_MIGRATION_BYTES=1048576
VIEWER_PAGE_SIZE=50
VIEWER_MAX_PAGE_SIZE=100
